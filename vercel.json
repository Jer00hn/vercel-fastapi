{
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    },
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    { "source": "/admin/(.*)", "destination": "/index.html" },
    { "source": "/", "destination": "/index.html" }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.py" },
    { "src": "/check/(.*)", "dest": "/api/index.py" },
    { "src": "/admin/(add|remove/.*)", "methods": ["POST"], "dest": "/api/index.py" },
    { "src": "/admin/(remove/.*)", "methods": ["DELETE"], "dest": "/api/index.py" }
  ]
}
